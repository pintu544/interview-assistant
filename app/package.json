{
  "name": "interview-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Screen-aware AI assistant with a stealth overlay (personal Windows build)",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "clean": "node node_modules/rimraf/dist/esm/bin.mjs dist",
    "build": "npm run clean && node node_modules/typescript/bin/tsc -p tsconfig.main.json && node node_modules/vite/bin/vite.js build",
    "lint": "node node_modules/eslint/bin/eslint.js src",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx,json,css}\"",
    "dist": "npm run build && node node_modules/electron-builder/out/cli/cli.js --win portable"
  },
  "license": "UNLICENSED",
  "keywords": [],
  "author": "",
  "build": {
    "appId": "com.pintukumar.interview-assistant",
    "productName": "Interview Assistant",
    "executableName": "InterviewAssistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "InterviewAssistant-portable.exe"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
